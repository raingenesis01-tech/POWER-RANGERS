#pragma once

// Copy this file to secrets.h in the same folder, then fill in the real values.
// secrets.h is listed in .gitignore. Do not commit Wi-Fi passwords or Blynk tokens.

// A phone hotspot is a useful backup when school Wi-Fi blocks a new ESP32.
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// From the Blynk template and the device page. See docs/BLYNK_SETUP.md.
#define BLYNK_TEMPLATE_ID "TMPL0000000000"
#define BLYNK_TEMPLATE_NAME "Classroom Occupancy"
#define BLYNK_AUTH_TOKEN "PASTE_DEVICE_TOKEN"

// GPIO connected to the sensor OUT pin. GPIO 27 is free on most ESP32 DevKit boards.
#define SENSOR_PIN 27

// 1 means a HIGH signal is "person present". Change to 0 if a hand wave does the opposite.
#define SENSOR_ACTIVE_HIGH 1
